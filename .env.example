# =============================================================================
# BookItRAG Environment Variables
# =============================================================================
# Copy this file to .env and fill in ALL required values
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Required)
# -----------------------------------------------------------------------------
# SQLite (default for local development) - file-based, zero config
# Format: sqlite:///./bookitrag.db
# The file is created automatically on first run
DATABASE_URL=sqlite:///./bookitrag.db

# PostgreSQL (for production) - uncomment and configure
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
# Get from: Your PostgreSQL provider (local, Supabase, Neon, Railway, etc.)
# Example: postgresql+psycopg2://postgres:password@localhost:5432/bookitrag_db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/bookitrag_db

# -----------------------------------------------------------------------------
# REDIS (Required)
# -----------------------------------------------------------------------------
# Redis connection URL for chat history storage
# Get from: Your Redis provider (local, Redis Cloud, Upstash, Railway, etc.)
# Format: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# Chat session TTL in seconds (default: 86400 = 24 hours)
REDIS_SESSION_TTL=86400

# -----------------------------------------------------------------------------
# GOOGLE GEMINI API (Required)
# -----------------------------------------------------------------------------
# Google Gemini API key for LLM (chat, embedding, booking extraction)
# Get from: https://aistudio.google.com/apikey
# 1. Go to Google AI Studio
# 2. Click "Create API Key"
# 3. Copy the key
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-1.0-pro
LLM_MODEL_NAME=gemini-1.5-flash

# -----------------------------------------------------------------------------
# EMBEDDINGS (Required)
# -----------------------------------------------------------------------------
# HuggingFace sentence transformer model for embeddings
# Must match EMBEDDING_DIMENSION below
# Default: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions)
# Get from: https://huggingface.co/sentence-transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Embedding vector dimension size
# MUST match the model above:
# - all-MiniLM-L6-v2 = 384
# - all-mpnet-base-v2 = 768
# - all-MiniLM-L12-v2 = 384
EMBEDDING_DIMENSION=384

# -----------------------------------------------------------------------------
# PINECONE (Required)
# -----------------------------------------------------------------------------
# Pinecone API key for vector database
# Get from: https://app.pinecone.io/
# 1. Create account at pinecone.io
# 2. Create a project
# 3. Copy API key from "API Keys" tab
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone index name (will be created if doesn't exist)
# Get from: Pinecone console → Indexes → create index
# Dimension must match EMBEDDING_DIMENSION (384)
# Metric: cosine
PINECONE_INDEX_NAME=bookitrag-index

# -----------------------------------------------------------------------------
# SMTP EMAIL (Required for booking confirmations)
# -----------------------------------------------------------------------------
# SMTP server address
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com
# Custom: your SMTP provider's server
SMTP_SERVER=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP username (your email address)
SMTP_USERNAME=your_email@gmail.com

# SMTP password / App Password
# Gmail: Use App Password (NOT your login password)
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Select "Mail" → Generate → Use that 16-char password
SMTP_PASSWORD=your_app_password

# Sender email address (shown in "From" field)
SENDER_EMAIL=your_email@gmail.com

# -----------------------------------------------------------------------------
# APP SETTINGS (Optional)
# -----------------------------------------------------------------------------
APP_NAME=BookItRAG API
APP_VERSION=1.0.0
DEBUG=False